{
  "uid": "fluxroute",
  "title": "FluxRoute Serving",
  "tags": ["fluxroute"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "5s",
  "time": { "from": "now-15m", "to": "now" },
  "panels": [
    {
      "type": "timeseries",
      "title": "Routing latency (p50 / p95 / p99)",
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 0 },
      "fieldConfig": {
        "defaults": { "unit": "s", "custom": { "lineWidth": 2, "fillOpacity": 5 } },
        "overrides": []
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum(rate(fluxroute_route_latency_seconds_bucket[1m])) by (le))",
          "legendFormat": "p50",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.95, sum(rate(fluxroute_route_latency_seconds_bucket[1m])) by (le))",
          "legendFormat": "p95",
          "refId": "B"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(fluxroute_route_latency_seconds_bucket[1m])) by (le))",
          "legendFormat": "p99",
          "refId": "C"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Throughput (requests/sec by instance)",
      "gridPos": { "h": 9, "w": 12, "x": 12, "y": 0 },
      "fieldConfig": {
        "defaults": { "unit": "reqps", "custom": { "lineWidth": 2, "fillOpacity": 10, "stacking": { "mode": "normal" } } },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(rate(fluxroute_route_requests_total{status=\"ok\"}[1m])) by (instance)",
          "legendFormat": "{{instance}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Latency breakdown: Redis feature fetch vs model scoring (p99)",
      "gridPos": { "h": 9, "w": 12, "x": 0, "y": 9 },
      "fieldConfig": {
        "defaults": { "unit": "s", "custom": { "lineWidth": 2, "fillOpacity": 5 } },
        "overrides": []
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.99, sum(rate(fluxroute_feature_fetch_seconds_bucket[1m])) by (le))",
          "legendFormat": "redis feature fetch",
          "refId": "A"
        },
        {
          "expr": "histogram_quantile(0.99, sum(rate(fluxroute_scoring_latency_seconds_bucket[1m])) by (le))",
          "legendFormat": "model scoring",
          "refId": "B"
        }
      ]
    },
    {
      "type": "timeseries",
      "title": "Route selection distribution",
      "gridPos": { "h": 9, "w": 6, "x": 12, "y": 9 },
      "fieldConfig": {
        "defaults": { "unit": "reqps", "custom": { "lineWidth": 2, "fillOpacity": 10, "stacking": { "mode": "normal" } } },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(rate(fluxroute_route_selected_total[1m])) by (route_id)",
          "legendFormat": "{{route_id}}",
          "refId": "A"
        }
      ]
    },
    {
      "type": "stat",
      "title": "Observed success rate",
      "gridPos": { "h": 9, "w": 6, "x": 18, "y": 9 },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "min": 0,
          "max": 1,
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "red", "value": null },
              { "color": "orange", "value": 0.9 },
              { "color": "green", "value": 0.95 }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(rate(fluxroute_outcomes_total{result=\"success\"}[5m])) / clamp_min(sum(rate(fluxroute_outcomes_total[5m])), 0.001)",
          "refId": "A"
        }
      ]
    }
  ]
}
